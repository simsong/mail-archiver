"""Minimal Cocoa Foundation selectors used by mailarchiver."""
from typing import Callable, Mapping, Self

class NSUserDefaults:
    @classmethod
    def standardUserDefaults(cls) -> Self: ...
    def registerDefaults_(self, values: Mapping[str, object]) -> None: ...

class NSURL:
    @classmethod
    def fileURLWithPath_(cls, path: str) -> Self: ...
    @classmethod
    def URLWithString_(cls, value: str) -> Self | None: ...
    def path(self) -> str: ...
    def absoluteString(self) -> str: ...

class NSBundle:
    @classmethod
    def mainBundle(cls) -> Self: ...
    def localizedInfoDictionary(self) -> dict[str, str] | None: ...
    def infoDictionary(self) -> dict[str, str]: ...

class NSProcessInfo:
    @classmethod
    def processInfo(cls) -> Self: ...
    def setProcessName_(self, name: str) -> None: ...


class NSThread:
    @classmethod
    def isMainThread(cls) -> bool: ...

class NSTimer:
    @classmethod
    def timerWithTimeInterval_repeats_block_(cls, interval: float, repeats: bool, callback: Callable[[Self], None]) -> Self: ...
    def invalidate(self) -> None: ...

class NSRunLoop:
    @classmethod
    def mainRunLoop(cls) -> Self: ...
    def addTimer_forMode_(self, timer: NSTimer, mode: str) -> None: ...

class NSNotificationCenter:
    @classmethod
    def defaultCenter(cls) -> Self: ...
    def addObserverForName_object_queue_usingBlock_(self, name: str, obj: object, queue: object, callback: Callable[..., object]) -> object: ...
    def removeObserver_(self, observer: object) -> None: ...
